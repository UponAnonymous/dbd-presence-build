<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The log redaction sink (threat-model review TM-12; NFR-PRIV-02). The sink lives in the WPF app project but uses no WPF, so its source is compiled
    here and the tests run on Linux, as the update tests do for src/DbdPresence.App/Updates.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DbdPresence.Core/DbdPresence.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/DbdPresence.App/Logging/*.cs" Link="App/Logging/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>
</Project>
