<Window x:Class="DbdPresence.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DbdPresence.App.Views"
        xmlns:vm="clr-namespace:DbdPresence.Presentation.ViewModels;assembly=DbdPresence.Presentation"
        xmlns:chars="clr-namespace:DbdPresence.Presentation.Characters;assembly=DbdPresence.Presentation"
        xmlns:lab="clr-namespace:DbdPresence.Presentation.Labelling;assembly=DbdPresence.Presentation"
        x:Name="Root"
        Title="DBD Presence"
        Icon="Assets/app.ico"
        MinWidth="880" MinHeight="600"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="{DynamicResource FontSizeBody}"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="MainWindow">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomePage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiscordStatusViewModel}"><views:DiscordStatusPage /></DataTemplate>
    <DataTemplate DataType="{x:Type chars:CharactersViewModel}"><views:CharactersPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountViewModel}"><views:AccountPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type lab:StudyViewModel}"><views:StudyPage /></DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid x:Name="ShellRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Command bar: always visible (UI_SPEC §2). At large text sizes or narrow widths the controls wrap onto a second line
           (right-aligned) instead of clipping; every control keeps its text label, tooltip and automation name. -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,8,16,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/app.ico" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="DBD Presence logo" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="DBD Presence" VerticalAlignment="Center" TextWrapping="NoWrap"
                       AutomationProperties.AutomationId="ShellTitle" />
          </StackPanel>

          <!-- The connection pill and one Pause button (design §2): Streamer mode is the Private style, profiles are under Advanced. -->
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding Controls}">
            <Border Style="{StaticResource Badge}" Margin="16,4,0,4" VerticalAlignment="Center" ToolTip="{Binding Connection.Detail}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,8,0"
                           Text="{Binding Connection.Tone, Converter={StaticResource ToneGlyph}}"
                           Foreground="{Binding Connection.Tone, Converter={StaticResource ToneBrush}}" />
                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextBrush}" Text="{Binding Connection.Text}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" views:LiveRegion.Announce="True" AutomationProperties.AutomationId="ConnectionStatus"
                           AutomationProperties.HelpText="{Binding Connection.Detail}" />
              </StackPanel>
            </Border>
            <ToggleButton Style="{StaticResource PauseButton}" IsChecked="{Binding IsPaused}" Margin="16,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="PauseToggle" AutomationProperties.Name="{Binding PauseName}" AutomationProperties.HelpText="Stops showing your status until you resume.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeBody}" Text="{Binding PauseGlyph}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding PauseLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </WrapPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1">
        <!-- One-time startup notice (e.g. settings restored from a backup). -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,2" Padding="16,8"
                Visibility="{Binding Notice, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Dismiss" Command="{Binding DismissNoticeCommand}"
                    AutomationProperties.AutomationId="DismissNotice" />
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Notice}" VerticalAlignment="Center" AutomationProperties.AutomationId="NoticeText" />
          </DockPanel>
        </Border>

        <!-- Announcement from the owner (signed configuration): plain text, dismissed per announcement. -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="16,8"
                Visibility="{Binding Announcement, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Dismiss" Command="{Binding DismissAnnouncementCommand}"
                    AutomationProperties.AutomationId="DismissAnnouncement" AutomationProperties.Name="Dismiss this announcement" />
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE789;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Announcement}" TextWrapping="Wrap" VerticalAlignment="Center"
                       views:LiveRegion.Announce="True" AutomationProperties.AutomationId="AnnouncementText" />
          </DockPanel>
        </Border>

        <!-- The running version is below the owner's minimum: a calm note, never a block. -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,2" Padding="16,8"
                Visibility="{Binding UpdateNotice, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Dismiss" Command="{Binding DismissUpdateNoticeCommand}"
                    AutomationProperties.AutomationId="DismissUpdateNotice" AutomationProperties.Name="Dismiss the update note" />
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE895;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding UpdateNotice}" TextWrapping="Wrap" VerticalAlignment="Center"
                       views:LiveRegion.Announce="True" AutomationProperties.AutomationId="UpdateNoticeText" />
          </DockPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="8,16">
          <ListBox x:Name="Navigation" Style="{StaticResource NavList}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                   MinWidth="{Binding NavWidth, ElementName=Root}" AutomationProperties.AutomationId="Navigation" AutomationProperties.Name="Pages">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, StringFormat=nav-{0}}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <!-- The rail sizes to its widest item (the width is a minimum), so icons and names never clip at a larger font scale; compact mode drops the gap. -->
                  <TextBlock Text="{Binding Glyph}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                        <Setter Property="Margin" Value="0,0,16,0" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsNavCompact, ElementName=Root}" Value="True">
                            <Setter Property="Margin" Value="0" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                             Visibility="{Binding IsNavCompact, ElementName=Root, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding SelectedPage.Page}" Focusable="False" IsTabStop="False"
                        AutomationProperties.AutomationId="PageHost" />
      </Grid>
    </Grid>

    <!-- First-run setup covers the shell until finished or skipped (FR-LIFE-07). -->
    <views:FirstRunView x:Name="FirstRun" Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}" />

    <!-- The lock screen covers everything until the device holds a verified licence (D32). -->
    <views:UnlockView x:Name="Unlock" Visibility="{Binding IsShown, Converter={StaticResource VisibleWhen}}" />
  </Grid>
</Window>
