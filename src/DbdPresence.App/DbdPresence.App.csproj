<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>DBD-Presence</AssemblyName>
    <RootNamespace>DbdPresence.App</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>Unofficial Discord Rich Presence companion for Dead by Daylight</Description>
  </PropertyGroup>
  <!-- The UI-test build (D32): set only by the UI test project's reference to this project, never by the solution, a Release build or a publish. It defines
       DBDP_UITEST (which compiles in a throw-away licence key that exists only for the UI tests) and builds into its own folders so it can never replace
       the Release output. Referenced projects are built without it (GlobalPropertiesToRemove), so the libraries are the same in both builds. -->
  <PropertyGroup Condition="'$(DbdUiTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);DBDP_UITEST</DefineConstants>
    <OutputPath>bin\UiTest\</OutputPath>
    <IntermediateOutputPath>obj\UiTest\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Core/DbdPresence.Core.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Configuration/DbdPresence.Configuration.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Discord/DbdPresence.Discord.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Packs/DbdPresence.Packs.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Online/DbdPresence.Online.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Vision/DbdPresence.Vision.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Study/DbdPresence.Study.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Presentation/DbdPresence.Presentation.csproj" />
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.Platform.Windows/DbdPresence.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build order and restore only: the app never links the image helper (it is a separate process, FR-PACK-10).
         The helper is added to the build and publish output by the targets below. -->
    <ProjectReference GlobalPropertiesToRemove="DbdUiTestBuild" Include="../DbdPresence.ImageHelper/DbdPresence.ImageHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- A plain build (developers, the UI tests) needs the helper next to the app too, or imports fail with "image helper could not be started". -->
  <Target Name="CopyImageHelperToBuildOutput" AfterTargets="Build">
    <MSBuild Projects="../DbdPresence.ImageHelper/DbdPresence.ImageHelper.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_ImageHelperTarget" />
    </MSBuild>
    <PropertyGroup>
      <_ImageHelperDir>@(_ImageHelperTarget->'%(RootDir)%(Directory)')</_ImageHelperDir>
    </PropertyGroup>
    <ItemGroup>
      <_ImageHelperFile Include="$(_ImageHelperDir)DbdPresence.ImageHelper.*" Exclude="$(_ImageHelperDir)*.pdb;$(_ImageHelperDir)*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(_ImageHelperFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Ship the helper next to the app: publish it with the same runtime settings into the same folder. -->
  <Target Name="PublishImageHelper" AfterTargets="Publish">
    <MSBuild Projects="../DbdPresence.ImageHelper/DbdPresence.ImageHelper.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir);NoBuild=false" />
  </Target>
  <ItemGroup>
    <!-- Custom Main in Program.cs (Velopack hook must run first; ADR-0006). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Original artwork generated by build/generate-icons.py (no third-party or game assets). -->
    <Resource Include="Assets\*.ico" />
    <!-- The full privacy notice ships next to the program; first run shows where it is (docs/legal/privacy-notice.md). -->
    <Content Include="../../docs/legal/privacy-notice.md" Link="privacy-notice.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Third-party notices ship next to the program (RELEASE_CHECKLIST §8). The runtime file is an unmodified copy of
         THIRD-PARTY-NOTICES.TXT from Microsoft.NETCore.App.Runtime.win-x64 10.0.13; replace it when the runtime version changes. -->
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../build/notices/THIRD-PARTY-NOTICES-dotnet-runtime.txt" Link="THIRD-PARTY-NOTICES-dotnet-runtime.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
