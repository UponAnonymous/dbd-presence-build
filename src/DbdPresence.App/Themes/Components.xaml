<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Components of the whole-app design (docs/design/whole-app.md §9.9): status headline card, info strip, inset, style card, picture chip.
    Spacing uses 8, 16, 24, 32 (4 only inside a control); no colour is written here, only theme resources.
  -->

  <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The status headline: the only tinted card, with a 4 DIP stripe on the left in the tone colour (the view binds Background and BorderBrush to the tone). -->
  <Style x:Key="Hero.Card" TargetType="Border">
    <Setter Property="BorderThickness" Value="4,1,1,1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- A quiet strip with a leading icon, for notices on a page. -->
  <Style x:Key="InfoStrip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="InfoStrip.Danger" TargetType="Border" BasedOn="{StaticResource InfoStrip}">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Content grouped inside a card: never a card in a card. -->
  <Style x:Key="Inset" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Style card: a radio button with the style's name, caption and live two-line preview. Selected = gold-tinted fill and a 2 DIP outline. -->
  <Style x:Key="StyleCard" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource ControlRadius}" Padding="16" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Choice chip (pictures): a pill that shows its selected state by a gold outline and a check word is always in the label, never colour alone. -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                  CornerRadius="16" Padding="16,0" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="Mark" Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeCaption}" Text="&#xE73E;" Margin="0,0,8,0" Visibility="Collapsed" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The command bar's Pause button: a toggle whose text and icon flip between Pause and Resume; paused shows a tinted fill as well as the words. -->
  <Style x:Key="PauseButton" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource ControlRadius}" Padding="16,0" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Radio button as a plain choice (wizard, pause choice). -->
  <Style x:Key="Choice" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- Characters page (docs/design/characters-page.md §10). Spacing is on the 8 DIP grid; 4 is used only inside a control. -->

  <!-- Danger button: a secondary button with danger text and boundary, for removing things; it is always followed by an inline confirmation. -->
  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Search box: the glyph, hint text and clear button are drawn by the page over the left and right 32 DIP of padding. -->
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="32,0" />
  </Style>

  <!-- Segmented choice (All / Killers / Survivors): one segment is selected, shown by a fill, a 2 DIP bottom bar and semibold text. -->
  <Style x:Key="Segmented" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="{StaticResource ControlRadius}"
                  Padding="16,0" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The track the segments sit in. -->
  <Style x:Key="SegmentedTrack" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Filter chip (a toggle): the check glyph and a blue outline show that it is on, so it never relies on colour alone. -->
  <Style x:Key="FilterChip" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource ControlRadius}" Padding="16,0" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="Mark" Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeCaption}" Text="&#xE73E;" Margin="0,0,8,0" Visibility="Collapsed" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A character tile in the list: a transparent 2 DIP border at rest, so selecting never shifts the layout. Hover changes the fill only. -->
  <Style x:Key="CharacterTile" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Width="116" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                  CornerRadius="{StaticResource ControlRadius}" Padding="8" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The list the tiles sit in: no chrome, wrapping rows, and no horizontal scrolling. -->
  <Style x:Key="TileList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource CharacterTile}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A picture option in the side panel (radio semantics): selected shows a 2 DIP blue border and the In use badge, never colour alone. -->
  <Style x:Key="PictureOption" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="Transparent" BorderThickness="2"
                  CornerRadius="{StaticResource ControlRadius}" Padding="8" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" />
                <Ellipse x:Name="Dot" Margin="4" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress: a 4 DIP line, blue on the raised surface. -->
  <Style x:Key="ProgressLine" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="PART_Track" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The eye mark on a portrait whose picture cannot reach Discord now. -->
  <Style x:Key="PreviewMark" TargetType="Border">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The picture frame used by tiles, previews, options and rows: a raised surface behind a clipped picture. -->
  <Style x:Key="PictureFrame" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
</ResourceDictionary>
