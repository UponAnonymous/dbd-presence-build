<UserControl x:Class="DbdPresence.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DbdPresence.App.Views"
             xmlns:vm="clr-namespace:DbdPresence.Presentation.ViewModels;assembly=DbdPresence.Presentation"
             Background="{DynamicResource BgBrush}"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             AutomationProperties.AutomationId="Unlock">
  <!-- The lock screen (D32): shown instead of the app until the device holds a verified licence. The sign-in and invite steps of the startup wizard (docs/design/whole-app.md §13), nothing else. -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <Border Style="{StaticResource Card}" MaxWidth="680" Margin="24,32" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" AutomationProperties.AutomationId="UnlockTitle" />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding Reason}"
                   views:LiveRegion.Announce="True" AutomationProperties.AutomationId="UnlockReason" />
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static vm:AppCopy.SignInShares}" />

        <StackPanel DataContext="{Binding Account}">
          <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}">
            <Run Text="Signed in as " /><Run Text="{Binding DisplayName, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource InlineMessage}" Text="{Binding Notice}" TextWrapping="Wrap"
                     Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UnlockNotice" />
          <TextBlock Style="{StaticResource InlineMessage}" Text="{Binding Message}" TextWrapping="Wrap"
                     Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" views:LiveRegion.Announce="True" AutomationProperties.AutomationId="UnlockMessage" />

          <!-- Sign in -->
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding IsSignedOut, Converter={StaticResource VisibleWhen}}">
            <Button x:Name="SignInButton" Style="{StaticResource Button.Primary}" Content="Sign in with Discord" Command="{Binding SignInCommand}" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="UnlockSignIn" />
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UnlockCancelSignIn" />
          </StackPanel>

          <!-- Invite code: only while the service asks for one and the signed configuration does not say the access mode is public -->
          <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowInvite, Converter={StaticResource VisibleWhen}}">
            <TextBlock Style="{StaticResource Text.Label}" Text="Invite code" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="Your code looks like XXXX-XXXX-XXXX-XXXX." />
            <TextBox Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,8,0,0" HorizontalAlignment="Left" Width="320"
                     AutomationProperties.AutomationId="UnlockInviteCode" AutomationProperties.Name="Invite code" />
            <Button Style="{StaticResource Button.Primary}" Content="Use code" Command="{Binding RedeemInviteCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="UnlockRedeem" />
          </StackPanel>

          <!-- Check again: signed in but locked for a reason a refresh can fix -->
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding CanCheckAgain, Converter={StaticResource VisibleWhen}}">
            <Button Style="{StaticResource Button.Primary}" Content="Check again" Command="{Binding CheckAgainCommand}" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="UnlockCheckAgain" />
          </StackPanel>

          <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"
                  Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UnlockSignOut" />
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Label}" Text="What the service keeps" Margin="0,24,0,8" />
        <ItemsControl ItemsSource="{Binding Notice}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="• " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- The app never opens files itself (SAFETY_AND_PRIVACY): the file name is shown, the full location is the tooltip. -->
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" ToolTip="{Binding Privacy.PrivacyNoticePath}"
                   Text="The full privacy notice is the file privacy-notice.md in the same folder as the program." AutomationProperties.AutomationId="UnlockPrivacyNoticeNote" />
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{x:Static vm:AppCopy.NetworkStatement}" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
