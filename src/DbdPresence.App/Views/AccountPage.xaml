<UserControl x:Class="DbdPresence.App.Views.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DbdPresence.App.Views"
             AutomationProperties.AutomationId="AccountPage">
  <UserControl.Resources>
    <views:PackImageConverter x:Key="PackImage" />
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Style="{StaticResource Text.Title}" Text="Account" />
      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,16" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="640"
                 Text="You sign in with Discord to use DBD Presence. Once you are in, your Discord status keeps working on this PC even when the service can't be reached." />

      <Border Style="{StaticResource SectionCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Sign in with Discord" Margin="0,0,0,16" />
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="820" Text="{Binding StatusText}"
                     views:LiveRegion.Announce="True" AutomationProperties.AutomationId="AccountStatus" />
          <TextBlock Style="{StaticResource Text.Label}" Margin="0,8,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}"
                     AutomationProperties.AutomationId="AccountDisplayName">
            <Run Text="Signed in as " /><Run Text="{Binding DisplayName, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource InlineMessage}" Text="{Binding Notice}" TextWrapping="Wrap" MaxWidth="820"
                     Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="AccountNotice" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Primary}" Content="Sign in with Discord" Command="{Binding SignInCommand}" Margin="0,0,8,0"
                    Visibility="{Binding ShowSignIn, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="AccountSignIn" />
            <Button Content="Check again" Command="{Binding CheckAgainCommand}" Margin="0,0,8,0"
                    Visibility="{Binding CanCheckAgain, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="AccountCheckAgain" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="AccountCancel" />
            <Button Content="Sign out" Command="{Binding SignOutCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="AccountSignOut" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="820"
                     Text="Opens Discord in your browser. Only your Discord name is kept; your profile picture is never shown here." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}" Visibility="{Binding ShowInvite, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Enter your invite code" Margin="0,0,0,16" />
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="820"
                     Text="Access is by invitation for now. Your code looks like XXXX-XXXX-XXXX-XXXX." />
          <TextBox Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,8,0,0" HorizontalAlignment="Left" Width="320"
                   AutomationProperties.AutomationId="AccountInviteCode" AutomationProperties.Name="Invite code" />
          <Button Style="{StaticResource Button.Primary}" Content="Use code" Command="{Binding RedeemInviteCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="AccountRedeem" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource InlineMessage}" Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="820" Margin="0,0,0,16"
                 Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" views:LiveRegion.Announce="True"
                 AutomationProperties.AutomationId="AccountMessage" />

      <!-- Uploads (FR-ONL-09): only local files are ever shown here; an upload without a copy on this PC gets a labelled tile. -->
      <Border Style="{StaticResource SectionCard}" DataContext="{Binding Uploads}"
              Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Text="Your pictures online" AutomationProperties.AutomationId="AccountUploads" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Refresh" Command="{Binding RefreshCommand}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}"
                    AutomationProperties.AutomationId="UploadsRefresh" AutomationProperties.Name="Refresh the list of uploaded images" />
          </DockPanel>
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="820"
                     Text="Add one of your own pictures on the Characters page so Discord can show it in your status. Pictures are used only in your own status." />
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="820" Margin="0,6,0,0" Text="{Binding UnlistedText}" />
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="820" Margin="0,4,0,0" Text="{Binding DiscordCacheText}" />
          <TextBlock Style="{StaticResource InlineMessage}" TextWrapping="Wrap" MaxWidth="820" Text="{Binding UnavailableText}"
                     Visibility="{Binding UnavailableText, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UploadsUnavailable" />
          <TextBlock Style="{StaticResource InlineMessage}" TextWrapping="Wrap" MaxWidth="820" Text="{Binding BlockedText}"
                     Visibility="{Binding HasBlockedText, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UploadsBlocked" />

          <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0" Visibility="{Binding ShowPolicy, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Label}" Text="Upload policy" AutomationProperties.AutomationId="UploadPolicy" />
              <ItemsControl ItemsSource="{Binding PolicyRules}" Margin="0,4,0,0" KeyboardNavigation.IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="800" Margin="0,2,0,0" Text="{Binding StringFormat=• {0}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="800" Margin="0,6,0,0" Text="{Binding FileRulesText}" />
              <Button Style="{StaticResource Button.Primary}" Content="I accept the upload policy" Command="{Binding AcceptPolicyCommand}" Margin="0,8,0,0"
                      HorizontalAlignment="Left" AutomationProperties.AutomationId="UploadPolicyAccept" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,0" Text="{Binding QuotaText}" AutomationProperties.AutomationId="UploadsQuota"
                     Visibility="{Binding QuotaText, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" Text="You have not uploaded any images."
                     Visibility="{Binding HasNoItems, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UploadsEmpty" />
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0" KeyboardNavigation.IsTabStop="False" AutomationProperties.AutomationId="UploadsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="56" Height="56" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceRaisedBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <Grid>
                      <Image Source="{Binding Preview, Converter={StaticResource PackImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                             AutomationProperties.Name="{Binding UsedFor, StringFormat=Preview of the uploaded image ({0})}" />
                      <TextBlock Style="{StaticResource Text.Caption}" Text="No copy on this PC" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                 Margin="4" Visibility="{Binding HasNoPreview, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding UsedFor}" TextWrapping="Wrap" AutomationProperties.Name="{Binding AutomationName}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Details}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource InlineMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Delete this image from the service? Its address stops working, but Discord may keep showing its cached copy for a while."
                               Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Delete" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="UploadDelete"
                            AutomationProperties.Name="{Binding UsedFor, StringFormat=Delete the uploaded image ({0})}"
                            Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <Button Content="Delete for good" Command="{Binding ConfirmDeleteCommand}" AutomationProperties.AutomationId="UploadDeleteConfirm"
                            Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}" />
                    <Button Style="{StaticResource Button.Subtle}" Content="Keep" Command="{Binding CancelDeleteCommand}" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="UploadDeleteCancel" Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource InlineMessage}" Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="820" Margin="0,8,0,0"
                     Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" views:LiveRegion.Announce="True"
                     AutomationProperties.AutomationId="UploadsMessage" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Delete my account" />
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="820" Text="{Binding DeleteAccountText}"
                     AutomationProperties.AutomationId="AccountDeleteText" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="Type DELETE to confirm" />
          <TextBox Text="{Binding DeleteConfirmation, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" HorizontalAlignment="Left" Width="200"
                   AutomationProperties.AutomationId="AccountDeleteConfirm" AutomationProperties.Name="Type DELETE to confirm deleting the account" />
          <Button Content="Delete my account" Command="{Binding DeleteAccountCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="AccountDelete" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
