<UserControl x:Class="DbdPresence.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DbdPresence.App.Views"
             AutomationProperties.AutomationId="HomePage">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Style="{StaticResource Text.Title}" Text="Home" Margin="0,0,0,16" />

      <!-- 1. Status headline: is it working? One state, one sentence, at most one button, two facts (design §3.2). -->
      <Border Style="{StaticResource Hero.Card}" DataContext="{Binding Hero}"
              Background="{Binding Tone, Converter={StaticResource ToneSoft}}" BorderBrush="{Binding Tone, Converter={StaticResource ToneBrush}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Icon}" FontSize="32" Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,0,16,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
              <TextBlock Style="{StaticResource Text.Display}" Text="{Binding Title}" views:LiveRegion.Announce="True" AutomationProperties.AutomationId="HeroTitle" />
              <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Detail}" Margin="0,8,0,0" MaxWidth="640" AutomationProperties.AutomationId="HeroDetail" />
            </StackPanel>
          </Grid>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Facts}" Margin="32,0,0,0" KeyboardNavigation.IsTabStop="False" AutomationProperties.AutomationId="HeroFacts">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeBody}" Text="{Binding Tone, Converter={StaticResource ToneGlyph}}"
                               Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Value}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
            <!-- Collapsed by default: with no Action the Action.Kind path is unresolved, WPF skips the converter and a Visibility binding falls back to Visible. -->
            <Button Content="{Binding Action.Label}" Command="{Binding DataContext.RunHeroActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.AutomationId="HeroResume" AutomationProperties.Name="Resume my Discord status">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Action.Kind}" Value="Resume">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="{Binding Action.Label}" Command="{Binding DataContext.RunHeroActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.AutomationId="HeroAction">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Action}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Action.Kind}" Value="Resume">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 2. Next steps: only when there is one, never in the healthy live state (design §3.5). -->
      <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasNextSteps, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding NextStepsTitle}" />
          <ItemsControl ItemsSource="{Binding NextSteps}" KeyboardNavigation.IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Text.Icon}" FontSize="20" Text="&#xE946;" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Sentence}" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{Binding ActionLabel}" Margin="0,0,8,0"
                            Command="{Binding DataContext.RunNextStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}"
                            AutomationProperties.AutomationId="{Binding Id, StringFormat=NextStep-{0}}" />
                    <Button Style="{StaticResource Button.Subtle}" Content="{Binding DismissLabel}"
                            Visibility="{Binding DismissLabel, Converter={StaticResource VisibleWhen}}"
                            Command="{Binding DataContext.DismissNextStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}"
                            AutomationProperties.AutomationId="{Binding Id, StringFormat=DismissNextStep-{0}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 3. What Discord shows now | What the app sees (design §3.1). Stacks below 760 DIP. -->
      <Grid views:ResponsiveColumns.StackBelow="760">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SectionCard}" Margin="0">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="What Discord shows now" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding PausedLine}" Margin="0,0,0,8"
                       Visibility="{Binding PausedLine, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="PausedLine" />
            <Grid Margin="0,0,0,8" Visibility="{Binding DeliveryNote, Converter={StaticResource VisibleWhen}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeBody}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding DeliveryNote}" AutomationProperties.AutomationId="DeliveryNote" />
            </Grid>
            <ContentPresenter Content="{Binding Preview}" HorizontalAlignment="Left" MaxWidth="460" Visibility="{Binding IsCardShown, Converter={StaticResource VisibleWhen}}" />
            <Border Style="{StaticResource Inset}" MinHeight="120" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="20" Text="&#xE946;" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding EmptyText}" AutomationProperties.AutomationId="EmptyCardText" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Hints}" AutomationProperties.AutomationId="PreviewHints" />

            <StackPanel Visibility="{Binding HasReasons, Converter={StaticResource VisibleWhen}}" Margin="0,16,0,0">
              <TextBlock Style="{StaticResource Text.Label}" Text="Why some details are missing" />
              <ItemsControl ItemsSource="{Binding ShownReasons}" AutomationProperties.AutomationId="WhyHidden" KeyboardNavigation.IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeBody}" Text="&#xE946;" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource Button.Subtle}" Content="{Binding ShowAllLabel}" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Visibility="{Binding ShowAllVisible, Converter={StaticResource VisibleWhen}}" Command="{Binding ShowAllReasonsNowCommand}"
                      AutomationProperties.AutomationId="ShowAllReasons" />
            </StackPanel>

            <Button Style="{StaticResource Button.Subtle}" Content="Change how it looks ›" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Command="{Binding ChangeHowItLooksCommand}" AutomationProperties.AutomationId="ChangeHowItLooks" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="What the app sees" Margin="0,0,0,16" AutomationProperties.AutomationId="WhatTheAppSees" />
            <TextBlock Style="{StaticResource Text.Muted}"
                       Text="The app reads your game screen to tell what you're doing. A detail goes on Discord only once the app is sure of it." />
            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding SeenLine}" Margin="0,16,0,0" AutomationProperties.AutomationId="SeenLine" />
            <Button Style="{StaticResource Button.Subtle}" Content="Screen reading settings ›" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Command="{Binding OpenScreenReadingSettingsCommand}" AutomationProperties.AutomationId="OpenScreenReadingSettings" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
