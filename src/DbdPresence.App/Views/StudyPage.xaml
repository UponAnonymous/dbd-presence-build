<UserControl x:Class="DbdPresence.App.Views.StudyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DbdPresence.App.Views"
             xmlns:lab="clr-namespace:DbdPresence.Presentation.Labelling;assembly=DbdPresence.Presentation"
             AutomationProperties.AutomationId="StudyPage">
  <!-- The owner-only Study page (FR-LAB-04, UI_SPEC "Study (owner only)"). It exists only while the signed-in account is the owner's own game account.
       Pictures are small PNGs made on this PC and shown from memory; nothing is loaded from the network. -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title, Mode=OneWay}" />
      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,16" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="640" Text="{Binding Intro, Mode=OneWay}" />

      <!-- Recording from the app (FR-LAB-06): owner only, after a one-time confirmation of what is saved. Pictures stay on this PC; nothing is uploaded. -->
      <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsRecordingConfirmationNeeded, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding RecordingConfirmTitle, Mode=OneWay}" AutomationProperties.AutomationId="StudyRecordingConfirmPanel" />
          <ItemsControl ItemsSource="{Binding RecordingConfirmParagraphs}" Focusable="False" KeyboardNavigation.IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="820" Text="{Binding Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding RecordingConfirmButtonText, Mode=OneWay}"
                  Command="{Binding ConfirmRecordingCommand}" AutomationProperties.AutomationId="StudyRecordingConfirm" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsRecordingControlsShown, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Record a play session" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource Button.Primary}" Content="Start recording" Command="{Binding StartRecordingCommand}" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="StudyStartRecording" />
            <Button Content="Stop recording" Command="{Binding StopRecordingCommand}" AutomationProperties.AutomationId="StudyStopRecording" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="820" Text="{Binding RecordingStatusText, Mode=OneWay}"
                     views:LiveRegion.Announce="True" AutomationProperties.AutomationId="StudyRecordingStatus" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="820" Text="{Binding RecordingNote, Mode=OneWay}"
                     Visibility="{Binding RecordingNote, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="StudyRecordingNote" />
        </StackPanel>
      </Border>

      <!-- The one-time confirmation (ADR-0018, SAFETY_AND_PRIVACY 3.3): nothing is uploaded until the owner has pressed the button once. -->
      <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsConfirmationNeeded, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ConfirmTitle, Mode=OneWay}" AutomationProperties.AutomationId="StudyConfirmPanel" />
          <ItemsControl ItemsSource="{Binding ConfirmParagraphs}" Focusable="False" KeyboardNavigation.IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="820" Text="{Binding Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding ConfirmButtonText, Mode=OneWay}"
                  Command="{Binding ConfirmLabellingCommand}" AutomationProperties.AutomationId="StudyConfirm" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsLabellingOn, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Automatic labelling" />
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="820" Margin="0,0,0,8" Text="{Binding PrivacyNotice, Mode=OneWay}"
                     AutomationProperties.AutomationId="StudyPrivacy" />
          <CheckBox Style="{StaticResource SettingSwitch}" Content="Label new recordings automatically after I play" IsChecked="{Binding LabelAfterPlay}"
                    AutomationProperties.AutomationId="StudyLabelAfterPlay" />
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="640"
                     Text="It starts a short while after the game has closed, never while it is running." />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Primary}" Content="Label new recordings now" Command="{Binding LabelNowCommand}" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="StudyLabelNow" />
            <Button Content="Refresh the list" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="StudyRefresh" />
            <Button Content="Turn off automatic labelling" Command="{Binding WithdrawLabellingCommand}" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="StudyWithdraw" AutomationProperties.Name="Turn off automatic labelling and ask again before the next upload" />
          </StackPanel>
          <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}"
                       AutomationProperties.AutomationId="StudyProgressBar" AutomationProperties.Name="Automatic labelling is working" />
          <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="820" Text="{Binding ProgressText, Mode=OneWay}"
                     Visibility="{Binding ProgressText, Converter={StaticResource VisibleWhen}}" views:LiveRegion.Announce="True"
                     AutomationProperties.AutomationId="StudyProgress" />
          <TextBlock Style="{StaticResource InlineMessage}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="820" Text="{Binding ProblemText, Mode=OneWay}"
                     Foreground="{DynamicResource WarningBrush}" Visibility="{Binding ProblemText, Converter={StaticResource VisibleWhen}}"
                     views:LiveRegion.Announce="True" AutomationProperties.AutomationId="StudyProblem" />
          <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="820" Text="{Binding ResultText, Mode=OneWay}"
                     Visibility="{Binding ResultText, Converter={StaticResource VisibleWhen}}" views:LiveRegion.Announce="True"
                     AutomationProperties.AutomationId="StudyResult" />
        </StackPanel>
      </Border>

      <!-- The blind spot-check: pictures and choices only. No earlier answer and no suggestion is anywhere in this model. -->
      <Border Style="{StaticResource SectionCard}" DataContext="{Binding SpotCheck}" Visibility="{Binding Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title, Mode=OneWay}" AutomationProperties.AutomationId="StudySpotCheckTitle" />
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="820" Text="{Binding Intro, Mode=OneWay}" />
          <ItemsControl ItemsSource="{Binding Segments}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type lab:SpotCheckSegmentRowViewModel}">
                <Border Style="{StaticResource Surface}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Pictures}" Margin="0,8,0,0" KeyboardNavigation.IsTabStop="False" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Image Source="{Binding Converter={StaticResource PngBytes}}" Width="192" Margin="0,0,8,8" Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="A picture from the recording" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" Margin="0,8,0,0"
                              TextSearch.TextPath="Label" AutomationProperties.AutomationId="StudySceneChoice" AutomationProperties.Name="{Binding ChoiceName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource InlineMessage}" Foreground="{DynamicResource WarningBrush}" Text="{Binding Missing, Mode=OneWay}"
                               Visibility="{Binding Missing, Converter={StaticResource VisibleWhen}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,0" Text="Matches" Visibility="{Binding HasMatches, Converter={StaticResource VisibleWhen}}" />
          <ItemsControl ItemsSource="{Binding Matches}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type lab:SpotCheckMatchRowViewModel}">
                <Border Style="{StaticResource Surface}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Title, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{Binding Pictures}" Margin="0,8,0,0" KeyboardNavigation.IsTabStop="False" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Image Source="{Binding Converter={StaticResource PngBytes}}" Width="192" Margin="0,0,8,8" Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="A picture from the match" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Your role" />
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                              AutomationProperties.AutomationId="StudyRoleChoice" AutomationProperties.Name="{Binding RoleName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Your character" />
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" TextSearch.TextPath="Label"
                              AutomationProperties.AutomationId="StudyCharacterChoice" AutomationProperties.Name="{Binding CharacterName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Map" />
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" TextSearch.TextPath="Label"
                              AutomationProperties.AutomationId="StudyMapChoice" AutomationProperties.Name="{Binding MapName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Result (survivors)" Visibility="{Binding ShowResult, Converter={StaticResource VisibleWhen}}" />
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                              Visibility="{Binding ShowResult, Converter={StaticResource VisibleWhen}}"
                              AutomationProperties.AutomationId="StudyResultChoice" AutomationProperties.Name="{Binding ResultName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Killer (skip if unsure; an answer is compared with the labels)" />
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Killers}" SelectedItem="{Binding SelectedKiller}" TextSearch.TextPath="Label"
                              AutomationProperties.AutomationId="StudyKillerChoice" AutomationProperties.Name="{Binding KillerName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Queue (skip if unsure; an answer is compared with the labels)" />
                    <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Queues}" SelectedItem="{Binding SelectedQueue}" TextSearch.TextPath="Label"
                              AutomationProperties.AutomationId="StudyQueueChoice" AutomationProperties.Name="{Binding QueueName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource InlineMessage}" Foreground="{DynamicResource WarningBrush}" Text="{Binding Missing, Mode=OneWay}"
                               Visibility="{Binding Missing, Converter={StaticResource VisibleWhen}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource InlineMessage}" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="820" Foreground="{DynamicResource WarningBrush}"
                     Text="{Binding Message, Mode=OneWay}" Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" views:LiveRegion.Announce="True"
                     AutomationProperties.AutomationId="StudySpotCheckMessage" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Primary}" Content="Save my answers" Margin="0,0,8,0"
                    Command="{Binding DataContext.SaveSpotCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.AutomationId="StudySaveSpotCheck" />
            <Button Content="Not now" Command="{Binding DataContext.CloseSpotCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.AutomationId="StudyCloseSpotCheck" AutomationProperties.Name="Close the spot-check without saving" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Recordings" />
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="820" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}"
                     Text="There are no recordings yet. Turn on recording above if asked, press Start recording and play; the recording appears here and is labelled after you close the game."
                     AutomationProperties.AutomationId="StudyEmpty" />
          <ItemsControl ItemsSource="{Binding Recordings}" AutomationProperties.AutomationId="StudyRecordings" AutomationProperties.Name="Recordings"
                        KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type lab:RecordingRowViewModel}">
                <Border Style="{StaticResource Surface}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Spot-check" VerticalAlignment="Center" Margin="16,0,0,0"
                            Visibility="{Binding CanSpotCheck, Converter={StaticResource VisibleWhen}}"
                            Command="{Binding DataContext.OpenSpotCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.AutomationId="StudyOpenSpotCheck" AutomationProperties.Name="{Binding SpotCheckName, Mode=OneWay}" />
                    <StackPanel>
                      <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Id, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding StateText, Mode=OneWay}" AutomationProperties.AutomationId="StudyRowState" />
                      <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding TokensText, Mode=OneWay}"
                                 Visibility="{Binding TokensText, Converter={StaticResource VisibleWhen}}" />
                      <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding SkippedText, Mode=OneWay}"
                                 Visibility="{Binding SkippedText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
