<UserControl x:Class="DbdPresence.App.Views.StudioAdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DbdPresence.App.Views"
             AutomationProperties.AutomationId="StudioAdvanced">
  <!-- Discord status, Advanced (design §4.3). DataContext is the Discord status model; the editor is its Studio. Insets, never cards in cards. -->
  <StackPanel Margin="0,8,0,0">
    <!-- 1. Write your own text -->
    <Border Style="{StaticResource Inset}">
      <StackPanel DataContext="{Binding Studio}">
        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Write your own text" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Text for" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Targets}" SelectedValue="{Binding Target}"
                  AutomationProperties.AutomationId="TemplateTarget" AutomationProperties.Name="Text for" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding LiveStateNote}" AutomationProperties.AutomationId="LiveStateNote" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Moment" />
        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" HorizontalAlignment="Left" MinWidth="320"
                  AutomationProperties.AutomationId="StudioState" AutomationProperties.Name="Moment">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="8,0">
                  <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeCaption}" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{Binding ReachabilityNote}" AutomationProperties.AutomationId="ReachabilityNote" />

        <ContentPresenter Content="{Binding Details}" AutomationProperties.AutomationId="FieldDetails" />
        <ContentPresenter Content="{Binding StateLine}" AutomationProperties.AutomationId="FieldState" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Add a detail" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Click a detail to add it where your cursor is. If the app isn't sure of a detail, that part is left out." />
        <ItemsControl ItemsSource="{Binding Tokens}" AutomationProperties.AutomationId="TokenPalette" KeyboardNavigation.IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Label}" ToolTip="{Binding Description}" Margin="0,0,8,8" Click="OnTokenClick"
                      AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding Description}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentPresenter Content="{Binding LargeText}" />
        <ContentPresenter Content="{Binding SmallText}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Big picture for this moment" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding ImageSources}" SelectedValue="{Binding LargeImageSource}"
                  AutomationProperties.AutomationId="LargeImageSource" AutomationProperties.Name="Big picture for this moment" />
        <TextBox Margin="0,8,0,0" Text="{Binding LargeImageValue, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                 Visibility="{Binding LargeImageNeedsValue, Converter={StaticResource VisibleWhen}}"
                 AutomationProperties.AutomationId="LargeImageValue" AutomationProperties.Name="Picture link or the name of a picture in your own Discord app" />
        <TextBlock Style="{StaticResource InlineMessage}" Foreground="{DynamicResource DangerBrush}" Text="{Binding LargeImageError}"
                   Visibility="{Binding LargeImageError, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Small badge for this moment" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding SmallImageSources}" SelectedValue="{Binding SmallImageSource}"
                  AutomationProperties.AutomationId="SmallImageSource" AutomationProperties.Name="Small badge for this moment" />
        <TextBox Margin="0,8,0,0" Text="{Binding SmallImageValue, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                 Visibility="{Binding SmallImageNeedsValue, Converter={StaticResource VisibleWhen}}"
                 AutomationProperties.AutomationId="SmallImageValue" AutomationProperties.Name="Picture link or the name of a picture in your own Discord app for the small badge" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding AutomaticSmallBadgeNote}" AutomationProperties.AutomationId="AutomaticSmallBadgeNote" />
        <TextBlock Style="{StaticResource InlineMessage}" Foreground="{DynamicResource DangerBrush}" Text="{Binding SmallImageError}"
                   Visibility="{Binding SmallImageError, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SmallImageNeedsLargeNote}"
                   Visibility="{Binding ShowsSmallImageNeedsLargeNote, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="SmallImageNeedsLargeNote" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Timer for this moment" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding TimerSources}" SelectedValue="{Binding Timer}"
                  AutomationProperties.AutomationId="TimerSource" AutomationProperties.Name="Timer for this moment" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Text used right now" />
        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding FallbackExplanation}" AutomationProperties.AutomationId="FallbackExplanation" />
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="Reset this moment" Command="{Binding ResetStateCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ResetState" />
          <Button Content="Reset all my text" Command="{Binding ResetAllTextCommand}" AutomationProperties.AutomationId="ResetAllText" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 2. Buttons on your status -->
    <Border Style="{StaticResource Inset}">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Buttons on your status" />
        <CheckBox Style="{StaticResource SettingSwitch}" DataContext="{Binding Privacy}" IsChecked="{Binding ShowButtons}" Content="Show buttons" AutomationProperties.AutomationId="ShowButtons" />
        <TextBlock Style="{StaticResource Text.Caption}" Text="Discord hides buttons on your own profile. Ask a friend to check them." />
        <Grid Margin="0,8,0,0" DataContext="{Binding Studio}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Text.Caption}" Text="Button text (up to 32 characters)" />
          <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="Link (https://…)" />
          <TextBox Grid.Row="1" Margin="0,4,0,0" Text="{Binding Button1Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                   AutomationProperties.AutomationId="Button1Label" AutomationProperties.Name="First button text" />
          <TextBox Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" Text="{Binding Button1Url, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                   AutomationProperties.AutomationId="Button1Url" AutomationProperties.Name="First button link" />
          <TextBox Grid.Row="2" Margin="0,8,0,0" Text="{Binding Button2Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                   AutomationProperties.AutomationId="Button2Label" AutomationProperties.Name="Second button text" />
          <TextBox Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Text="{Binding Button2Url, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                   AutomationProperties.AutomationId="Button2Url" AutomationProperties.Name="Second button link" />
        </Grid>
        <TextBlock Style="{StaticResource InlineMessage}" Foreground="{DynamicResource DangerBrush}" Text="{Binding Studio.ButtonsError}"
                   Visibility="{Binding Studio.ButtonsError, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="ButtonsError" />
      </StackPanel>
    </Border>

    <!-- 3. How Discord describes it -->
    <Border Style="{StaticResource Inset}">
      <StackPanel DataContext="{Binding Studio}">
        <TextBlock Style="{StaticResource Text.Subtitle}" Text="How Discord describes it" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Discord says" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding ActivityKinds}" SelectedValue="{Binding ActivityKind}"
                  AutomationProperties.AutomationId="ActivityKind" AutomationProperties.Name="Discord says" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Member list shows" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding StatusDisplays}" SelectedValue="{Binding StatusDisplay}"
                  AutomationProperties.AutomationId="StatusDisplay" AutomationProperties.Name="Member list shows" />
      </StackPanel>
    </Border>

    <!-- 4. More privacy -->
    <Border Style="{StaticResource Inset}">
      <StackPanel DataContext="{Binding Privacy}">
        <TextBlock Style="{StaticResource Text.Subtitle}" Text="More privacy" />
        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding PostMatchDetailsOnly}" Content="Wait until the match ends before showing the map and match details"
                  AutomationProperties.AutomationId="PostMatchDetailsOnly" />
        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding HideFullActivity}" Content="Hide my activity completely"
                  AutomationProperties.AutomationId="HideFullActivity" AutomationProperties.HelpText="Like Pause, but stays on until you turn it off." />
        <TextBlock Style="{StaticResource Text.Caption}" Text="Like Pause, but stays on until you turn it off." />
      </StackPanel>
    </Border>

    <!-- 5. Saved setups: only when there is more than one -->
    <Border Style="{StaticResource Inset}" Visibility="{Binding HasSeveralSetups, Converter={StaticResource VisibleWhen}}">
      <StackPanel DataContext="{Binding Controls}">
        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Saved setups" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Setup in use" />
        <ComboBox Style="{StaticResource ChoiceCombo}" ItemsSource="{Binding Profiles}" SelectedValue="{Binding ActiveProfileId}"
                  AutomationProperties.AutomationId="ProfileSelector" AutomationProperties.Name="Setup in use" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
