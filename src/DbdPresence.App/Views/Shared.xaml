<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DbdPresence.App.Views"
                    xmlns:pres="clr-namespace:DbdPresence.Presentation.Presence;assembly=DbdPresence.Presentation"
                    xmlns:vm="clr-namespace:DbdPresence.Presentation.ViewModels;assembly=DbdPresence.Presentation">
  <!-- Shared page building blocks. Every colour/size is a theme resource (Themes/Controls.xaml + ThemeManager). -->

  <views:ToneGlyphConverter x:Key="ToneGlyph" />
  <views:ToneBrushConverter x:Key="ToneBrush" />
  <views:ToneSoftBrushConverter x:Key="ToneSoft" />
  <views:IconGlyphConverter x:Key="IconGlyph" />
  <views:ValuesEqualConverter x:Key="ValuesEqual" />
  <views:BoolNotConverter x:Key="BoolNot" />
  <views:VisibleWhenConverter x:Key="VisibleWhen" />
  <views:EnumIsConverter x:Key="EnumIs" />
  <views:HexBrushConverter x:Key="HexBrush" />
  <views:PackImageConverter x:Key="PackImage" />
  <views:PicturePathConverter x:Key="PicturePath" />
  <views:PngBytesConverter x:Key="PngBytes" />
  <views:EnumChoiceConverter x:Key="EnumChoice" />
  <views:FillHeightConverter x:Key="FillHeight" />

  <Style x:Key="PageScroll" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <Style x:Key="PageBody" TargetType="StackPanel">
    <Setter Property="MaxWidth" Value="960" />
    <Setter Property="Margin" Value="32,24,32,32" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style x:Key="SettingSwitch.Inline" TargetType="CheckBox" BasedOn="{StaticResource Switch.Inline}">
    <Setter Property="Margin" Value="0,4,16,4" />
  </Style>

  <!-- A quiet inset for rows inside a card (a card never sits inside a card). -->
  <Style x:Key="Surface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
    <Setter Property="Margin" Value="0,16,0,4" />
  </Style>

  <Style x:Key="ChoiceCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="DisplayMemberPath" Value="Label" />
    <Setter Property="SelectedValuePath" Value="Value" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MinWidth" Value="260" />
  </Style>

  <!-- Inline message: icon + text, coloured by severity. Hidden when the message is empty. -->
  <Style x:Key="InlineMessage" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <DataTemplate DataType="{x:Type pres:StatusLine}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Tone, Converter={StaticResource ToneGlyph}}"
                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,0,8,0" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" Text="{Binding Text}" />
      </Grid>
      <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Detail}" Margin="24,2,0,0"
                 Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
    </StackPanel>
  </DataTemplate>

  <!-- One Studio text field: label, editor, live counter and message. -->
  <DataTemplate DataType="{x:Type vm:TemplateFieldViewModel}">
    <StackPanel Margin="0,0,0,8">
      <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
      <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
               AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Counter}"
               views:TokenInsert.IsTarget="True" />
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Text.Icon}" FontSize="{DynamicResource FontSizeCaption}" Text="{Binding Severity, Converter={StaticResource ToneGlyph}}"
                   Foreground="{Binding Severity, Converter={StaticResource ToneBrush}}" Margin="0,0,6,0" VerticalAlignment="Top"
                   Visibility="{Binding Severity, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Text="{Binding Message}" Foreground="{Binding Severity, Converter={StaticResource ToneBrush}}"
                   Visibility="{Binding Severity, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding Counter}" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <!-- Approximate Discord activity card (UI_SPEC §3). No Discord logos; https artwork is never fetched. -->
  <DataTemplate DataType="{x:Type pres:ActivityPreview}">
    <StackPanel>
      <UserControl Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="PreviewCard" AutomationProperties.Name="Discord preview">
      <Border Background="{DynamicResource PreviewCardBrush}" CornerRadius="8" Padding="16" MinWidth="320">
        <Grid>
          <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource PreviewMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="SemiBold" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
          <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource PreviewMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.AutomationId="PreviewHeading" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="88" Height="88" Margin="0,0,16,0" VerticalAlignment="Top"
                    Visibility="{Binding LargeImage, Converter={StaticResource VisibleWhen}}">
                <Border CornerRadius="8" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        ToolTip="{Binding LargeImage.HoverText}">
                  <Grid>
                  <!-- A real picture only ever comes from a local, hash-verified file (PackImageConverter); a remote address is never bound here. -->
                  <Image Source="{Binding LargeImage.Location, Converter={StaticResource PackImage}}" Stretch="UniformToFill"
                         AutomationProperties.Name="{Binding LargeImage.Caption}" />
                  <StackPanel VerticalAlignment="Center" Margin="6" Visibility="{Binding LargeImage.Location, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEB9F;" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource PreviewMutedBrush}" />
                    <TextBlock Text="{Binding LargeImage.Caption}" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource PreviewMutedBrush}" />
                    <TextBlock Text="(not confirmed)" TextAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource PreviewMutedBrush}"
                               Visibility="{Binding LargeImage.IsUnconfirmed, Converter={StaticResource VisibleWhen}}" />
                  </StackPanel>
                  </Grid>
                </Border>
                <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8"
                        Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource PreviewCardBrush}" BorderThickness="3"
                        Visibility="{Binding SmallImage, Converter={StaticResource VisibleWhen}}"
                        ToolTip="{Binding SmallImage.Caption}" ClipToBounds="True">
                  <!-- Border has no automation peer, so the spoken name lives on this TextBlock; the text itself is transparent (the circle is too small to show it). -->
                  <Grid>
                  <Image Source="{Binding SmallImage.Location, Converter={StaticResource PackImage}}" Stretch="UniformToFill" />
                  <TextBlock Text="{Binding SmallImage.Caption}" Foreground="Transparent" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="NoWrap"
                             VerticalAlignment="Center" AutomationProperties.Name="{Binding SmallImage.Caption, StringFormat=Small image: {0}}" />
                  </Grid>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource PreviewTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="PreviewDetails" />
                <TextBlock Text="{Binding State}" Foreground="{DynamicResource PreviewTextBrush}" TextWrapping="Wrap"
                           Visibility="{Binding State, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="PreviewState" />
                <TextBlock Text="{Binding Elapsed}" Foreground="{DynamicResource PreviewMutedBrush}" FontSize="{DynamicResource FontSizeCaption}"
                           Visibility="{Binding Elapsed, Converter={StaticResource VisibleWhen}}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Background="{DynamicResource SurfaceHoverBrush}" Padding="16,8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource PreviewTextBrush}" HorizontalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
      </UserControl>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.AutomationId="PreviewCaption"
                 Text="Approximate preview. Discord may look a little different." />
    </StackPanel>
  </DataTemplate>

  <!-- One plain sentence about something missing from a preview, with its fix buttons (D29). -->
  <DataTemplate DataType="{x:Type pres:PreviewHint}">
    <StackPanel Margin="0,8,0,0">
      <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="{Binding Id, StringFormat=PreviewHint-{0}}" />
      <ItemsControl ItemsSource="{Binding Actions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,8,8,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
