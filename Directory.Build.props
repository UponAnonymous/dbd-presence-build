<Project>
  <!-- Shared build settings for every project. See docs/QUALITY_GATES.md (U1, U2, U9). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Required for IDE0005 (unused usings) to run at build time (dotnet/roslyn#41640).
         CS1591 (missing XML docs) is not enforced: public docs are encouraged, not mandated, in app code. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Supply chain: lock files everywhere, locked restore in CI (GitHub sets CI=true). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Vulnerability audit of direct and transitive packages at every restore. With warnings-as-errors a new
         advisory deliberately fails the build: security findings must be triaged, not ignored. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Product metadata (file properties of every binary). -->
    <Product>DBD Presence</Product>
    <Company>DBD Presence contributors</Company>
    <Copyright>Copyright (c) 2026 DBD Presence contributors</Copyright>
    <Version>0.1.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <WindowsTfm>net10.0-windows10.0.26100.0</WindowsTfm>
    <WindowsMinVersion>10.0.19041.0</WindowsMinVersion>
  </PropertyGroup>
</Project>
